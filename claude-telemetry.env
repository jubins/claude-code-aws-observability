# Source this file in the shell that starts Claude Code:  source claude-telemetry.env
export CLAUDE_CODE_ENABLE_TELEMETRY=1
export OTEL_METRICS_EXPORTER=otlp
export OTEL_LOGS_EXPORTER=otlp
export OTEL_EXPORTER_OTLP_PROTOCOL=grpc
export OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
export OTEL_METRIC_EXPORT_INTERVAL=10000
export OTEL_LOGS_EXPORT_INTERVAL=5000
# Keep session.id off the metrics. It is a new time series per session, which grows
# Prometheus storage locally and drives sample and series counts in Amazon Managed Service
# for Prometheus. Session-level detail stays available in the log events.
export OTEL_METRICS_INCLUDE_SESSION_ID=false
# Prompts, responses and tool parameters stay redacted unless you opt in. Leave those variables unset.
